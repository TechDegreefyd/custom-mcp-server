# ─── Online LMS ────────────────────────────────────────────────────────────────
ONLINE_LMS_DB_HOST=your-db-host.example.com
ONLINE_LMS_DB_PORT=5432
ONLINE_LMS_DB_NAME=online_lms_db
ONLINE_LMS_DB_USER=postgres
ONLINE_LMS_DB_PASSWORD=your_password_here

# ─── Regular LMS ───────────────────────────────────────────────────────────────
REGULAR_LMS_DB_HOST=your-db-host.example.com
REGULAR_LMS_DB_PORT=5432
REGULAR_LMS_DB_NAME=regular_lms_db
REGULAR_LMS_DB_USER=postgres
REGULAR_LMS_DB_PASSWORD=your_password_here

# ─── Regular LMS — CGC ─────────────────────────────────────────────────────────
REGULAR_CGC_LMS_DB_HOST=your-db-host.example.com
REGULAR_CGC_LMS_DB_PORT=5432
REGULAR_CGC_LMS_DB_NAME=regular_cgc_lms_db
REGULAR_CGC_LMS_DB_USER=postgres
REGULAR_CGC_LMS_DB_PASSWORD=your_password_here

# ─── Regular LMS — Amity ───────────────────────────────────────────────────────
REGULAR_AMITY_LMS_DB_HOST=your-db-host.example.com
REGULAR_AMITY_LMS_DB_PORT=5432
REGULAR_AMITY_LMS_DB_NAME=regular_amity_lms_db
REGULAR_AMITY_LMS_DB_USER=postgres
REGULAR_AMITY_LMS_DB_PASSWORD=your_password_here

# ─── MCP Server ────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Security ──────────────────────────────────────────────────────────────────
# Generate a strong token: openssl rand -hex 32
# Clients must send: Authorization: Bearer <your_token>
API_TOKEN=change_this_to_a_strong_secret_token

# ─── Limits ────────────────────────────────────────────────────────────────────
MAX_ROWS=200

# ─── WhatsApp (WHAPI) — optional ───────────────────────────────────────────────
WHAPI_TOKEN=
WHATSAPP_GROUP=
